# Copia como .env (NO lo subas a GitHub). Puedes reutilizar las 4 líneas DB_* de ../backend/.env
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aquat
DB_USER=aquatadmin
DB_PASS=tu_contraseña_mysql

# Clave para firmar los JWT (mínimo 32 caracteres)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta-123456

# Origen(es) del frontend permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:5173

# Contraseña de los usuarios de ejemplo (solo si las tablas están vacías)
SEED_PASSWORD=Aquat2026!
